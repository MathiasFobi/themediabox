# Copy to .env.local and fill in real values. Never commit .env.local.

# Public URL of the deployed storefront (used for photo-upload links in emails)
APP_URL=http://localhost:3000

# --- Stripe ---
# Secret key for the Stripe account that owns the Payment Links.
# Needed only for best-effort line-item enrichment on the webhook.
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for the /api/stripe/webhook endpoint
# (Stripe Dashboard → Developers → Webhooks → endpoint → Signing secret).
# The webhook refuses to run without this.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (Resend) ---
# Order confirmation emails are skipped (with a warning) if these are unset.
RESEND_API_KEY=re_...
RESEND_FROM=TheMediaBox <orders@example.com>

# --- Firebase Admin (service account) ---
# Used by API routes to save orders to Firestore and receive photo uploads
# in Firebase Storage. Same service account the guest-book worker uses.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional; defaults to <projectId>.appspot.com
FIREBASE_STORAGE_BUCKET=
